# /etc/cron.d/dcc-backup — VM timezone UTC, 02:15 UTC = 03:15 Lagos.
# Uses existing CPU/disk and a short-lived rclone upload to existing Google Drive.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 2 * * * root nice -n 19 timeout 10m bash /opt/devops-control-center/scripts/backup.sh >> /opt/devops-control-center/backups/backup.log 2>&1
